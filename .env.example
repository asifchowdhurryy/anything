# GEMINI_API_KEY: Default server-side Gemini API key.
# Users can also add their own custom keys in Settings > AI Providers.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Server Environment Configuration
PORT=3000
NODE_ENV="development"

